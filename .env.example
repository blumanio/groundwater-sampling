# Copia questo file in `.env` e compila i valori reali.
# ATTENZIONE: `.env` non deve MAI essere committato.

NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# Firma dei token JWT — usare una stringa casuale lunga
JWT_SECRET=

# Vercel Blob (upload certificati di taratura, foto rifiuti, ecc.)
BLOB_READ_WRITE_TOKEN=

# ── Notifiche scadenze taratura ───────────────────────────────────────────
# Segreto condiviso richiesto dall'endpoint /api/equipment/notifications/run
# (header `x-api-key`). Impostarlo anche nel flow di Power Automate.
NOTIFICATIONS_SECRET=

# Invio email diretto (opzionale — solo se NON si usa Power Automate/Outlook).
# Se SMTP_HOST non e' valorizzato l'endpoint restituisce solo il payload JSON.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Destinatario in copia per gli avvisi di scadenza (responsabile/QA)
NOTIFICATIONS_MANAGER_EMAIL=
